#!/usr/bin/env python3
"""Interactive, resumable local/Cloudflare setup. Python standard library only."""
from pathlib import Path
import argparse, getpass, hashlib, json, os, re, secrets, shutil, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
ROOT=Path(__file__).resolve().parent
STATE=Path(os.environ.get('SAMPLE_STATE_DIR',str(ROOT/'.sample'))).resolve()
DEFAULTS={'SAMPLE_MODE':'local','PORT':'4101','CORRIDORA_TARGET':'own','CORRIDORA_OTLP_ENDPOINT':'','CORRIDORA_RUM_KEY':'','CORRIDORA_RUM_SCRIPT_URL':'https://rum.corridora.com/corridora-rum.js','OTEL_SERVICE_NAME':'sample-gallery-api','OTEL_SERVICE_NAMESPACE':'corridora-samples.gallery','DEPLOYMENT_ENVIRONMENT':'development','DEMO_DAILY_START_UTC':'13:00','DEMO_WINDOW_SECONDS':'600','ENABLE_SYNTHETICS':'false','ENABLE_PROVIDER_FORWARDING':'false','RECOMMENDER_URL':'','TRACKER_SIMULATOR_URL':'','CLOUDFLARE_ACCOUNT_ID':'','RESOURCE_PREFIX':'sample-gallery','PUBLIC_ORIGIN':'','CUSTOM_DOMAIN':'','CLOUDFLARE_ZONE_ID':'','D1_DATABASE_ID':'','R2_BUCKET_NAME':'','KV_NAMESPACE_ID':'','QUEUE_NAME':'','GITHUB_REPOSITORY':''}
SECRET_NAMES=['CORRIDORA_INGEST_KEY','DEMO_CONTROL_TOKEN','DOWNSTREAM_AUTH_TOKEN','CLOUDFLARE_API_TOKEN','CLOUDFLARE_ANALYTICS_TOKEN']
PROMPTS={'SAMPLE_MODE':'Mode (local/cloud)','CORRIDORA_TARGET':'Corridora destination (own/demo; Demo requires operator keys)','CORRIDORA_OTLP_ENDPOINT':'OTLP ingest base URL (empty disables export locally)','CORRIDORA_RUM_KEY':'Public browser RUM key','CORRIDORA_RUM_SCRIPT_URL':'RUM script URL','OTEL_SERVICE_NAME':'API service name','OTEL_SERVICE_NAMESPACE':'Service namespace','DEPLOYMENT_ENVIRONMENT':'Environment','PORT':'Local port','RESOURCE_PREFIX':'Dedicated Cloudflare resource prefix','PUBLIC_ORIGIN':'Public origin (leave empty to discover workers.dev)','DEMO_DAILY_START_UTC':'Daily regression start UTC (HH:MM)','DEMO_WINDOW_SECONDS':'Regression window seconds (1–600)','ENABLE_SYNTHETICS':'Enable Cron backend probe and daily browser workflow (true/false)','ENABLE_PROVIDER_FORWARDING':'Create native OTLP log/trace destinations (true/false)','RECOMMENDER_URL':'Controlled GCP recommender base URL (empty uses fixture)','TRACKER_SIMULATOR_URL':'Controlled tracker script URL (empty disables)','CLOUDFLARE_ACCOUNT_ID':'Cloudflare account ID','CUSTOM_DOMAIN':'Optional custom hostname (no https://)','CLOUDFLARE_ZONE_ID':'Zone ID for custom domain','D1_DATABASE_ID':'Existing D1 ID (empty creates/discovers dedicated DB)','R2_BUCKET_NAME':'Existing R2 bucket (empty creates dedicated bucket)','KV_NAMESPACE_ID':'Existing KV namespace ID (empty creates/discovers dedicated namespace)','QUEUE_NAME':'Existing thumbnail queue name (empty creates/discovers dedicated queue)','GITHUB_REPOSITORY':'Published GitHub repository (corridora/sample-gallery; required for hosted browser schedules)'}

def private_write(path,data):
    path.parent.mkdir(parents=True,exist_ok=True);os.chmod(path.parent,0o700)
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
    with os.fdopen(fd,'w') as f:f.write(data)
    os.chmod(path,0o600)

def load(path=None):
    cfg=DEFAULTS.copy()
    for p in [STATE/'config.json',STATE/'secrets.json',Path(path) if path else None]:
        if p and p.exists():
            data=json.loads(p.read_text())
            if any(data.get(k) for k in SECRET_NAMES) and p.stat().st_mode&0o077:raise ValueError(f'{p} contains secrets; chmod 600 first')
            cfg.update({k:str(v) for k,v in data.items()})
    for k in list(cfg)+SECRET_NAMES:
        if k in os.environ:cfg[k]=os.environ[k]
    return cfg

def validate(cfg,cloud=False,deploy=False,teardown=False):
    if cfg['SAMPLE_MODE'] not in ('local','cloud'):raise ValueError('SAMPLE_MODE must be local or cloud')
    if cfg['CORRIDORA_TARGET'] not in ('own','demo'):raise ValueError('CORRIDORA_TARGET must be own or demo')
    if not 1024<=int(cfg['PORT'])<=65535:raise ValueError('PORT must be 1024–65535')
    if not 1<=int(cfg['DEMO_WINDOW_SECONDS'])<=600:raise ValueError('DEMO_WINDOW_SECONDS must be 1–600')
    if not re.fullmatch(r'(?:[01]\d|2[0-3]):[0-5]\d',cfg['DEMO_DAILY_START_UTC']):raise ValueError('Daily UTC time must be HH:MM')
    if not re.fullmatch(r'[a-z][a-z0-9-]{2,42}',cfg['RESOURCE_PREFIX']):raise ValueError('Invalid resource prefix')
    for key in ['CORRIDORA_OTLP_ENDPOINT','CORRIDORA_RUM_SCRIPT_URL','RECOMMENDER_URL','TRACKER_SIMULATOR_URL','PUBLIC_ORIGIN']:
        if not cfg.get(key):continue
        u=urllib.parse.urlparse(cfg[key]);local=cfg['SAMPLE_MODE']=='local' and u.scheme=='http' and u.hostname in ['localhost','127.0.0.1']
        if u.username or u.password or not u.hostname or (u.scheme!='https' and not local):raise ValueError(f'{key} must use HTTPS (local loopback HTTP allowed)')
    if cfg['CORRIDORA_TARGET']=='demo' and not teardown:
        cfg['DEPLOYMENT_ENVIRONMENT']='demo'
        for key in ['CORRIDORA_INGEST_KEY','CORRIDORA_RUM_KEY','CORRIDORA_OTLP_ENDPOINT']:
            if not cfg.get(key):raise ValueError(f'{key} required for operator-provisioned Demo export')
    if deploy:
        if len(cfg.get('DEMO_CONTROL_TOKEN',''))<16:raise ValueError('DEMO_CONTROL_TOKEN needs at least 16 characters')
    if cloud:
        for key in ['CLOUDFLARE_ACCOUNT_ID','CLOUDFLARE_API_TOKEN']:
            if not cfg.get(key):raise ValueError(f'{key} required; use a scoped API token, never an account password')
        if teardown:return
        for key in ['CORRIDORA_INGEST_KEY','CORRIDORA_RUM_KEY','CORRIDORA_OTLP_ENDPOINT']:
            if not cfg.get(key):raise ValueError(f'{key} required for cloud mode')
        if (cfg['ENABLE_SYNTHETICS']=='true' or cfg['ENABLE_PROVIDER_FORWARDING']=='true') and not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+',cfg.get('GITHUB_REPOSITORY','')):raise ValueError('GITHUB_REPOSITORY required for scheduled browser/native metric workflows')
        if cfg['ENABLE_PROVIDER_FORWARDING']=='true' and not cfg.get('CLOUDFLARE_ANALYTICS_TOKEN'):raise ValueError('CLOUDFLARE_ANALYTICS_TOKEN required for native metric forwarding')
        if cfg.get('CUSTOM_DOMAIN') and not cfg.get('CLOUDFLARE_ZONE_ID'):raise ValueError('Custom hostname requires CLOUDFLARE_ZONE_ID')

def configure(cfg,noninteractive):
    if not noninteractive:
        keys=list(PROMPTS)
        for k in keys:
            if k in ['CLOUDFLARE_ACCOUNT_ID','CUSTOM_DOMAIN','CLOUDFLARE_ZONE_ID','D1_DATABASE_ID','R2_BUCKET_NAME','KV_NAMESPACE_ID','QUEUE_NAME','GITHUB_REPOSITORY'] and cfg['SAMPLE_MODE']!='cloud':continue
            val=input(f"{PROMPTS[k]} [{cfg.get(k,'')}]: ").strip();cfg[k]=val or cfg.get(k,'')
        for k in SECRET_NAMES:
            if k in ['CLOUDFLARE_API_TOKEN','CLOUDFLARE_ANALYTICS_TOKEN'] and cfg['SAMPLE_MODE']!='cloud':continue
            if k=='CLOUDFLARE_ANALYTICS_TOKEN' and cfg['ENABLE_PROVIDER_FORWARDING']!='true':continue
            if k=='DOWNSTREAM_AUTH_TOKEN' and not cfg['RECOMMENDER_URL']:continue
            val=getpass.getpass(f'{k} (masked; Enter keeps existing, control token auto-generates): ')
            if val:cfg[k]=val
    cfg.setdefault('DEMO_CONTROL_TOKEN',secrets.token_urlsafe(32))
    if not cfg.get('DEMO_CONTROL_TOKEN'):cfg['DEMO_CONTROL_TOKEN']=secrets.token_urlsafe(32)
    validate(cfg,cloud=cfg['SAMPLE_MODE']=='cloud',deploy=True)
    private_write(STATE/'config.json',json.dumps({k:v for k,v in cfg.items() if k not in SECRET_NAMES},indent=2)+'\n')
    private_write(STATE/'secrets.json',json.dumps({k:cfg.get(k,'') for k in SECRET_NAMES},indent=2)+'\n')
    print('Saved protected configuration. Backend secrets never enter frontend config.')
    return cfg

def inventory():return json.loads((STATE/'inventory.json').read_text()) if (STATE/'inventory.json').exists() else {'account_id':'','resources':{}}
def save_inventory(inv):private_write(STATE/'inventory.json',json.dumps(inv,indent=2)+'\n')

def api(cfg,method,path,data=None):
    url='https://api.cloudflare.com/client/v4'+path
    req=urllib.request.Request(url,data=json.dumps(data).encode() if data is not None else None,method=method,headers={'Authorization':'Bearer '+cfg['CLOUDFLARE_API_TOKEN'],'Content-Type':'application/json'})
    try:
        with urllib.request.urlopen(req,timeout=30) as response:body=json.load(response)
    except urllib.error.HTTPError as e:raise RuntimeError(f'Cloudflare {method} {path} HTTP {e.code}; credentials and response body redacted') from None
    if not body.get('success',True):raise RuntimeError('Cloudflare operation rejected; inspect provider dashboard (response redacted)')
    return body.get('result')

def account_path(cfg,path):return '/accounts/'+cfg['CLOUDFLARE_ACCOUNT_ID']+path

def run(argv,cfg,stdin=None):
    env=os.environ.copy();env.update({k:str(v) for k,v in cfg.items() if k in ['CLOUDFLARE_API_TOKEN','CLOUDFLARE_ACCOUNT_ID']});env['WRANGLER_SEND_METRICS']='false'
    result=subprocess.run(argv,cwd=ROOT,env=env,input=stdin,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
    output=result.stdout
    for key in SECRET_NAMES:
        value=cfg.get(key,'')
        if value:output=output.replace(value,'[REDACTED]')
    print(output,end='')
    if result.returncode:raise RuntimeError(f'{argv[0]} exited {result.returncode}')
    return output

def version():
    result=subprocess.run(['git','rev-parse','HEAD'],cwd=ROOT,text=True,capture_output=True)
    if result.returncode==0 and not subprocess.run(['git','status','--porcelain'],cwd=ROOT,text=True,capture_output=True).stdout.strip():return result.stdout.strip()
    digest=hashlib.sha256()
    for directory in ['worker','src','migrations']:
        for file in sorted((ROOT/directory).rglob('*')):
            if file.is_file():digest.update(str(file.relative_to(ROOT)).encode());digest.update(file.read_bytes())
    digest.update((ROOT/'package-lock.json').read_bytes())
    return 'source-'+digest.hexdigest()[:16]

def generated(cfg,inv):
    template=json.loads((ROOT/'wrangler.jsonc').read_text());prefix=cfg['RESOURCE_PREFIX'];res=inv['resources']
    template['name']=prefix;template['main']=os.path.relpath(ROOT/'worker/index.ts',STATE);template['assets']['directory']=os.path.relpath(ROOT/'build',STATE);template['$schema']=os.path.relpath(ROOT/'node_modules/wrangler/config-schema.json',STATE)
    template['vars']={k:cfg.get(k,v) for k,v in template['vars'].items() if k not in SECRET_NAMES};template['vars']['SERVICE_VERSION']=version()
    template['d1_databases'][0].update(database_name=prefix+'-catalog',database_id=res.get('d1',{}).get('id',cfg.get('D1_DATABASE_ID') or template['d1_databases'][0]['database_id']),migrations_dir=os.path.relpath(ROOT/'migrations',STATE))
    template['r2_buckets'][0]['bucket_name']=res.get('r2',{}).get('id',cfg.get('R2_BUCKET_NAME') or prefix+'-images')
    template['kv_namespaces'][0]['id']=res.get('kv',{}).get('id',cfg.get('KV_NAMESPACE_ID') or template['kv_namespaces'][0]['id'])
    queue=res.get('queue',{}).get('name',cfg.get('QUEUE_NAME') or prefix+'-thumbnails');template['queues']['producers'][0]['queue']=queue;template['queues']['consumers'][0]['queue']=queue;template['queues']['consumers'][0]['dead_letter_queue']=prefix+'-dead'
    h,m=cfg['DEMO_DAILY_START_UTC'].split(':');minute=int(m);hour=int(h)
    template['triggers']['crons']=[f'{minute} {hour} * * *',f'{(minute+15)%60} {(hour+(minute+15)//60)%24} * * *',f'{(minute+30)%60} {(hour+(minute+30)//60)%24} * * *']
    if cfg['SAMPLE_MODE']=='cloud':template['account_id']=cfg['CLOUDFLARE_ACCOUNT_ID']
    if cfg.get('CUSTOM_DOMAIN'):template['routes']=[{'pattern':cfg['CUSTOM_DOMAIN'],'custom_domain':True,'zone_id':cfg['CLOUDFLARE_ZONE_ID']}]
    if cfg['ENABLE_PROVIDER_FORWARDING']=='true':
        for signal in ['logs','traces']:template['observability'][signal]['destinations']=[prefix+'-'+signal]
    private_write(STATE/'wrangler.json',json.dumps(template,indent=2)+'\n')
    private_write(STATE/'.dev.vars','\n'.join(k+'='+json.dumps(cfg.get(k,'')) for k in SECRET_NAMES if k not in ['CLOUDFLARE_API_TOKEN','CLOUDFLARE_ANALYTICS_TOKEN'])+'\n')
    return template

def plan(cfg,operation='deploy'):
    print(json.dumps({'operation':operation,'mode':cfg['SAMPLE_MODE'],'account':cfg.get('CLOUDFLARE_ACCOUNT_ID') or 'local','prefix':cfg['RESOURCE_PREFIX'],'resources':['Worker + static assets','D1 catalog','R2 images','KV policy','thumbnail Queue + dead-letter Queue','3 Cron triggers']+(['native OTLP logs/traces destinations'] if cfg['ENABLE_PROVIDER_FORWARDING']=='true' else []),'cost':'Workers Paid $5/account/month; tiny included D1/KV/Queues and R2 allowances; under fleet $20 goal at bounded traffic, no hard billing cap','reuse':{k:cfg[k] for k in ['D1_DATABASE_ID','R2_BUCKET_NAME','KV_NAMESPACE_ID','QUEUE_NAME'] if cfg.get(k)},'daily_utc':cfg['DEMO_DAILY_START_UTC'],'synthetics':cfg['ENABLE_SYNTHETICS']},indent=2))

def provision(cfg,inv):
    base=account_path(cfg,'');prefix=cfg['RESOURCE_PREFIX'];resources=inv['resources']
    if inv['account_id'] and inv['account_id']!=cfg['CLOUDFLARE_ACCOUNT_ID']:raise ValueError('Inventory belongs to another account')
    if inv.get('resource_prefix') and inv['resource_prefix']!=prefix:raise ValueError('Inventory belongs to a different prefix; choose a separate SAMPLE_STATE_DIR')
    inv['account_id']=cfg['CLOUDFLARE_ACCOUNT_ID'];inv['resource_prefix']=prefix;save_inventory(inv)
    specifications=[('d1','/d1/database','name','uuid',prefix+'-catalog',{'name':prefix+'-catalog'},'D1_DATABASE_ID'),('r2','/r2/buckets','name','name',prefix+'-images',{'name':prefix+'-images'},'R2_BUCKET_NAME'),('kv','/storage/kv/namespaces','title','id',prefix+'-config',{'title':prefix+'-config'},'KV_NAMESPACE_ID'),('dead','/queues','queue_name','queue_id',prefix+'-dead',{'queue_name':prefix+'-dead'},None),('queue','/queues','queue_name','queue_id',prefix+'-thumbnails',{'queue_name':prefix+'-thumbnails'},'QUEUE_NAME')]
    for key,path,name_key,id_key,name,body,reuse_key in specifications:
        if key in resources:continue
        existing=api(cfg,'GET',base+path)
        if isinstance(existing,dict):existing=existing.get('buckets',existing.get('queues',[]))
        reuse=cfg.get(reuse_key,'') if reuse_key else ''
        match=next((v for v in existing if v.get(id_key)==reuse or v.get(name_key)==(reuse or name)),None)
        if key=='queue' and match and match.get('consumers_total_count',0)>0:raise ValueError('Reused queue already has consumers; refusing to replace shared consumers')
        if reuse and not match:raise ValueError(f'Requested reused {key} not found in selected account')
        created=match or api(cfg,'POST',base+path,body)
        resources[key]={'id':created[id_key],'name':created.get(name_key,name),'path':path+'/'+str(created[id_key]),'owned':not bool(match)};save_inventory(inv)
    if 'worker' not in resources:
        scripts=api(cfg,'GET',base+'/workers/scripts')
        if any(v.get('id')==prefix for v in scripts):raise ValueError('Worker prefix already exists without ownership inventory; choose a unique RESOURCE_PREFIX')
        resources['worker']={'id':prefix,'name':prefix,'path':'/workers/scripts/'+prefix,'owned':True};save_inventory(inv)
    if cfg['ENABLE_PROVIDER_FORWARDING']=='true':
        for signal in ['logs','traces']:
            key='destination-'+signal
            if key in resources:
                if not resources[key].get('owned'):raise ValueError('Refusing to modify a shared telemetry destination')
                api(cfg,'PATCH',base+resources[key]['path'],{'enabled':True,'configuration':{'type':'logpush','url':cfg['CORRIDORA_OTLP_ENDPOINT'].rstrip('/')+'/v1/'+signal,'headers':{'X-CORRIDORA-KEY':cfg['CORRIDORA_INGEST_KEY']}}})
                continue
            name=prefix+'-'+signal
            existing=api(cfg,'GET',base+'/workers/observability/destinations')
            match=next((v for v in existing if v.get('name')==name),None)
            if match:raise ValueError('Native destination name already exists; choose a unique prefix')
            destination=api(cfg,'POST',base+'/workers/observability/destinations',{'name':name,'enabled':True,'configuration':{'type':'logpush','logpushDataset':'opentelemetry-'+signal,'url':cfg['CORRIDORA_OTLP_ENDPOINT'].rstrip('/')+'/v1/'+signal,'headers':{'X-CORRIDORA-KEY':cfg['CORRIDORA_INGEST_KEY']}}})
            resources[key]={'id':destination['slug'],'name':name,'path':'/workers/observability/destinations/'+destination['slug'],'owned':True};save_inventory(inv)

def deploy(cfg,args):
    validate(cfg);plan(cfg)
    if args.plan:return
    validate(cfg,cloud=cfg['SAMPLE_MODE']=='cloud',deploy=True)
    if cfg['SAMPLE_MODE']=='cloud' and not args.yes and input('Apply this Cloudflare plan? [y/N] ').strip().lower()!='y':return
    if not (ROOT/'node_modules').exists():run(['npm','ci'],cfg)
    run(['npm','run','build'],cfg)
    if cfg['SAMPLE_MODE']=='cloud' and (cfg['ENABLE_SYNTHETICS']=='true' or cfg['ENABLE_PROVIDER_FORWARDING']=='true'):
        if not shutil.which('gh'):raise ValueError('GitHub CLI required to configure scheduled workflows')
        run(['gh','auth','status'],cfg)
    inv=inventory()
    if cfg['SAMPLE_MODE']=='cloud':provision(cfg,inv)
    template=generated(cfg,inv);config=str(STATE/'wrangler.json');local=cfg['SAMPLE_MODE']=='local'
    run(['npx','wrangler','d1','execute','DB','--config',config,'--local' if local else '--remote','--file','migrations/0001_catalog.sql','--yes'],cfg)
    for file in sorted((ROOT/'fixtures').glob('*.svg')):run(['npx','wrangler','r2','object','put',template['r2_buckets'][0]['bucket_name']+'/'+file.name,'--config',config,'--local' if local else '--remote','--file',str(file),'--content-type','image/svg+xml'],cfg)
    run(['npx','wrangler','kv','key','put','catalog-policy','{"image_lookup":"stable"}','--binding','CONFIG','--config',config,'--local' if local else '--remote'],cfg)
    if not local:
        # Provision secret bindings before activating a new Worker, then deploy the complete bundle.
        private_write(STATE/'worker-secrets.json',json.dumps({k:cfg.get(k,'') for k in SECRET_NAMES if k not in ['CLOUDFLARE_API_TOKEN','CLOUDFLARE_ANALYTICS_TOKEN']}))
        try:run(['npx','wrangler','secret','bulk',str(STATE/'worker-secrets.json'),'--config',config],cfg)
        finally:(STATE/'worker-secrets.json').unlink(missing_ok=True)
        run(['npx','wrangler','deploy','--config',config],cfg)
        if not cfg.get('PUBLIC_ORIGIN'):
            subdomain=api(cfg,'GET',account_path(cfg,'/workers/subdomain'))['subdomain'];cfg['PUBLIC_ORIGIN']='https://'+(cfg['CUSTOM_DOMAIN'] or cfg['RESOURCE_PREFIX']+'.'+subdomain+'.workers.dev')
            private_write(STATE/'config.json',json.dumps({k:v for k,v in cfg.items() if k not in SECRET_NAMES},indent=2)+'\n')
    if not local and (cfg['ENABLE_SYNTHETICS']=='true' or cfg['ENABLE_PROVIDER_FORWARDING']=='true'):
        repo=cfg['GITHUB_REPOSITORY'];run(['gh','auth','status'],cfg)
        variables={'SAMPLE_BASE_URL':cfg['PUBLIC_ORIGIN'],'ENABLE_SYNTHETICS':cfg['ENABLE_SYNTHETICS'],'ENABLE_PROVIDER_FORWARDING':cfg['ENABLE_PROVIDER_FORWARDING'],'CLOUDFLARE_ACCOUNT_ID':cfg['CLOUDFLARE_ACCOUNT_ID'],'RESOURCE_PREFIX':cfg['RESOURCE_PREFIX'],'CORRIDORA_OTLP_ENDPOINT':cfg['CORRIDORA_OTLP_ENDPOINT']}
        for key,value in variables.items():run(['gh','variable','set',key,'--repo',repo,'--body',value],cfg)
        for key in ['DEMO_CONTROL_TOKEN']+(['CORRIDORA_INGEST_KEY','CLOUDFLARE_ANALYTICS_TOKEN'] if cfg['ENABLE_PROVIDER_FORWARDING']=='true' else []):run(['gh','secret','set',key,'--repo',repo],cfg,stdin=cfg[key])
    print('Local bindings seeded.' if local else 'Deployed '+cfg['PUBLIC_ORIGIN'])

def base_url(cfg):return ('http://localhost:'+cfg['PORT']) if cfg['SAMPLE_MODE']=='local' else cfg.get('PUBLIC_ORIGIN','')
def request(cfg,path,body=None):
    url=base_url(cfg)+path
    headers={'Content-Type':'application/json'}
    if body is not None:headers['Authorization']='Bearer '+cfg.get('DEMO_CONTROL_TOKEN','')
    req=urllib.request.Request(url,data=json.dumps(body).encode() if body is not None else None,headers=headers)
    with urllib.request.urlopen(req,timeout=15) as response:return json.load(response)
def verify(cfg,args):
    print(json.dumps(request(cfg,'/healthz'),indent=2));ids=request(cfg,'/api/trace-check');print('Backend trace:',ids['trace_id'])
    if not cfg.get('DEMO_CONTROL_TOKEN'):raise ValueError('DEMO_CONTROL_TOKEN required to verify regression')
    env=os.environ.copy();env.update({k:str(v) for k,v in cfg.items()});env['SAMPLE_BASE_URL']=base_url(cfg)
    result=subprocess.run(['npx','playwright','test'],cwd=ROOT,env=env)
    if result.returncode:raise RuntimeError('Browser validation failed')
    print('Browser journey passed. '+base_url(cfg)+'\nOpen docs/corridora-setup.md for stored Corridora CLIENT → SERVER parentage, native signals and session checks. Ingest acceptance alone does not prove storage.')

def destroy(cfg,args):
    inv=inventory();owned={k:v for k,v in inv['resources'].items() if v.get('owned')};plan(cfg,'destroy');print('Owned resources to remove:',', '.join(owned) or 'local state only')
    if args.plan:return
    if not args.yes and input('Delete only listed owned resources/state? [y/N] ').strip().lower()!='y':return
    if cfg['SAMPLE_MODE']=='cloud':
        validate(cfg,cloud=True,teardown=True)
        if inv['account_id']!=cfg['CLOUDFLARE_ACCOUNT_ID']:raise ValueError('Account mismatch; refusing teardown')
        # Remove only known seed objects, never empty an arbitrary reused bucket.
        if owned.get('r2'):
            for key in ['orbit.svg','fern.svg','clock.svg','thumbnails/demo-product.json','thumbnails/healthy-control.json','thumbnails/trace-clock.json']:
                try:run(['npx','wrangler','r2','object','delete',owned['r2']['id']+'/'+key,'--remote','--config',str(STATE/'wrangler.json')],cfg)
                except RuntimeError:pass
        for key in ['worker','destination-logs','destination-traces','queue','dead','kv','d1','r2']:
            if key not in owned:continue
            api(cfg,'DELETE',account_path(cfg,owned[key]['path']));del inv['resources'][key];save_inventory(inv)
        print('Owned infrastructure removed. Reused resources retained; remove CI secrets separately.')
    else:
        shutil.rmtree(STATE/'.wrangler',ignore_errors=True);print('Local binding state removed; saved setup answers retained.')

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('command',nargs='?',choices=['configure','deploy','run','verify','scenario','destroy']);parser.add_argument('--config',help='Protected JSON config; environment overrides values');parser.add_argument('--non-interactive',action='store_true');parser.add_argument('--plan','--dry-run',action='store_true',help='Print resource/cost plan without cloud calls');parser.add_argument('--yes',action='store_true',help='Apply reviewed plan without prompting');parser.add_argument('--phase',choices=['healthy','regression','recover'],default='regression');parser.add_argument('--duration',type=float,default=120);args=parser.parse_args();cfg=load(args.config)
    if args.command in [None,'configure']:cfg=configure(cfg,args.non_interactive)
    if args.command=='configure':return
    if args.command in [None,'deploy']:deploy(cfg,args)
    if args.command=='deploy':return
    if args.command in [None,'run']:
        if cfg['SAMPLE_MODE']=='cloud':print(json.dumps(request(cfg,'/healthz')));print(base_url(cfg));return
        if not (STATE/'wrangler.json').exists():raise ValueError('Run ./setup deploy to build and seed local bindings first')
        env=os.environ.copy();env['WRANGLER_SEND_METRICS']='false';command=['npx','wrangler','dev','--config',str(STATE/'wrangler.json'),'--port',cfg['PORT']]
        if args.command is None:
            process=subprocess.Popen(command,cwd=ROOT,env=env)
            try:
                for _ in range(60):
                    try:request(cfg,'/healthz');break
                    except (urllib.error.URLError,ConnectionError):time.sleep(.5)
                verify(cfg,args);process.wait()
            finally:process.terminate()
        else:subprocess.run(command,cwd=ROOT,env=env,check=True)
    elif args.command=='verify':verify(cfg,args)
    elif args.command=='scenario':
        if not 0<args.duration<=600:raise ValueError('duration must be finite in (0,600]')
        print(json.dumps(request(cfg,'/api/demo/scenario',{'phase':args.phase,'duration_seconds':args.duration}),indent=2))
    elif args.command=='destroy':destroy(cfg,args)
if __name__=='__main__':
    try:main()
    except (ValueError,RuntimeError,urllib.error.URLError,subprocess.CalledProcessError) as error:print('Setup error:',error,file=sys.stderr);sys.exit(1)
