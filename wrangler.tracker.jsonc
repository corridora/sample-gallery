{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": false
    }
  },
  "name": "sample-gallery-tracker",
  "main": "worker/tracker.ts",
  "workers_dev": true,
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "OTEL_SERVICE_NAME": "sample-gallery-tracker",
    "OTEL_SERVICE_NAMESPACE": "corridora-samples.gallery",
    "DEPLOYMENT_ENVIRONMENT": "demo",
    "SERVICE_VERSION": "set-actual-build-version",
    "CORRIDORA_OTLP_ENDPOINT": "https://ingest.corridora.com",
    "CLOUDFLARE_ACCOUNT_ID": "set-account-id",
    "TRACKER_ALLOWED_ORIGIN": "https://set-gallery-origin.example"
  }
}
