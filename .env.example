SAMPLE_MODE=local
PORT=4101
CORRIDORA_TARGET=own
# Empty endpoint/keys make the local quick start work without external telemetry.
CORRIDORA_OTLP_ENDPOINT=
CORRIDORA_INGEST_KEY=
CORRIDORA_RUM_KEY=
CORRIDORA_RUM_SCRIPT_URL=https://rum.corridora.com/corridora-rum.js
OTEL_SERVICE_NAME=sample-gallery-api
OTEL_SERVICE_NAMESPACE=corridora-samples.gallery
DEPLOYMENT_ENVIRONMENT=development
# SERVICE_VERSION is generated from clean commit or actual source/lock digest.
DEMO_CONTROL_TOKEN=
DEMO_DAILY_START_UTC=13:00
DEMO_WINDOW_SECONDS=600
ENABLE_PROVIDER_FORWARDING=false
ENABLE_SYNTHETICS=false
RECOMMENDER_URL=
DOWNSTREAM_AUTH_TOKEN=
TRACKER_SIMULATOR_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ANALYTICS_TOKEN=
RESOURCE_PREFIX=sample-gallery
PUBLIC_ORIGIN=
CUSTOM_DOMAIN=
CLOUDFLARE_ZONE_ID=
D1_DATABASE_ID=
R2_BUCKET_NAME=
KV_NAMESPACE_ID=
QUEUE_NAME=
# Test only: real Corridora RUM IIFE downloaded independently; never a synthetic SDK.
RUM_BUNDLE_PATH=

GITHUB_REPOSITORY=
