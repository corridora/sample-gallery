{
  "name": "sample-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "types": "wrangler types worker-configuration.d.ts",
    "dev": "wrangler dev --port 4101",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:setup": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "capture": "tsx scripts/capture.ts",
    "tracker": "tsx scripts/tracker.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "@playwright/test": "1.64.0",
    "typescript": "6.0.3",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "wrangler": "4.149.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "24.10.0"
  }
}
